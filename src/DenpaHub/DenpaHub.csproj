<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        各家庭の denpa から使う、Doa が動かす共通のサーバ (README.md)。
        機能ごとに Features/<名前>/ にまとめる。いまはニコニコの OAuth の中継だけ (docs/niconico.md)。

        Native AOT で実行ファイル1個にし、distroless のイメージに置く。依存のパッケージは足さない
        (ASP.NET Core と System.Security.Cryptography だけで足りる)。
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>denpa-hub</AssemblyName>
        <RootNamespace>DenpaHub</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DenpaHub.Tests" />
    </ItemGroup>

</Project>
