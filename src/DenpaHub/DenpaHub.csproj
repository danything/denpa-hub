<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        各家庭の denpa から使う、Doa が動かす共通のサーバ (README.md)。
        機能ごとに Features/<名前>/ にまとめる。ニコニコの OAuth の中継 (docs/niconico.md) と予約数ランキング (docs/ranking.md)。

        Native AOT で実行ファイルにし、distroless のイメージに置く。依存のパッケージは Microsoft.Data.Sqlite だけ
        (ランキングのデータ。AOT で動くことを確かめた。組み込みの SQLite の libe_sqlite3.so を実行ファイルの隣に置く)。
    -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>denpa-hub</AssemblyName>
        <RootNamespace>DenpaHub</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DenpaHub.Tests" />
    </ItemGroup>

</Project>
