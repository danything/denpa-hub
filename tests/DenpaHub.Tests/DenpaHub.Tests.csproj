<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- TUnit のテストは自分で実行できるアプリ (Microsoft.Testing.Platform)。
             Microsoft.NET.Test.Sdk は持たない (TUnit の検出を壊す) -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <!-- 本体と同じく、ICU を使わない (番組名の全角を半角に寄せる処理などが、ICU の無い本番と同じに動くことを確かめるため) -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="TUnit" Version="1.87.12" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
        <ProjectReference Include="../../src/DenpaHub/DenpaHub.csproj" />
    </ItemGroup>

</Project>
