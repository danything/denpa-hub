<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- TUnit のテストは自分で実行できるアプリ (Microsoft.Testing.Platform)。
             Microsoft.NET.Test.Sdk は持たない (TUnit の検出を壊す) -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="TUnit" Version="1.77.0" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
        <ProjectReference Include="../../src/DenpaHub/DenpaHub.csproj" />
    </ItemGroup>

</Project>
